{
  "type": "object",
  "title": "Money S3 Connection",
  "required": [
    "base_url",
    "client_id",
    "#client_secret",
    "agenda_id"
  ],
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Base URL",
      "default": "http://localhost:28085",
      "propertyOrder": 1
    },
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "propertyOrder": 3
    },
    "#client_secret": {
      "type": "string",
      "title": "Client Secret",
      "format": "password",
      "propertyOrder": 4
    },
    "agenda_id": {
      "type": "string",
      "title": "Agenda",
      "propertyOrder": 6,
      "enum": [],
      "format": "select",
      "options": {
        "async": {
          "label": "Load agendas",
          "action": "list_agendas"
        }
      }
    },
    "test_connection": {
      "type": "button",
      "format": "sync-action",
      "title": "Test Connection",
      "propertyOrder": 7,
      "options": {
        "async": {
          "label": "Test Connection",
          "action": "testConnection"
        }
      }
    }
  }
}
